# ===========================================================
# Hundler VPN - environment variables (EXAMPLE)
# Copy to .env (gitignored) and fill in REAL values.
# Variables marked [SECRET] must NEVER be committed.
# ===========================================================

# --- Application ---
APP_URL=
NEXT_PUBLIC_APP_URL=

# --- Database (PostgreSQL) ---
POSTGRESQL_DBNAME=
POSTGRESQL_HOST=
POSTGRESQL_PASSWORD=  # [SECRET]
POSTGRESQL_PORT=
POSTGRESQL_SSLMODE=
POSTGRESQL_SSL_CA_PATH=
POSTGRESQL_SSL_MODE=
POSTGRESQL_USER=

# --- Telegram bots ---
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=
BOT_API_SECRET=  # [SECRET]
CHAT_BOT_USERNAME=
MAIN_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_CHAT_TOKEN=  # [SECRET]
TELEGRAM_BOT_TOKEN=  # [SECRET]
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=  # [SECRET]

# --- OAuth (Google / Telegram login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=  # [SECRET]

# --- Payments (OxaPay / Platega) ---
OXAPAY_API_KEY=  # [SECRET]
PLATEGA_API_BASE_URL=
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=  # [SECRET]
PLATEGA_SECRET_KEY=  # [SECRET]

# --- Email (Resend / SMTP) ---
EMAIL_API=
RESEND_API_KEY=  # [SECRET]
RESEND_FROM_EMAIL=
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=  # [SECRET]
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=

# --- VPN / Xray / Hysteria2 ---
HYSTERIA_AUTH_SECRET=  # [SECRET]
SYNC_SCRIPT=
SYNC_TOKEN=  # [SECRET]
VPN_WEBHOOK_SECRET=  # [SECRET]
XRAY_REALITY_FINGERPRINT=
XRAY_REALITY_PUBLIC_KEY=
XRAY_REALITY_SHORT_ID=
XRAY_REALITY_SNI=
XRAY_SYNC_TOKEN=  # [SECRET]
XRAY_VLESS_COUNTRY=
XRAY_VLESS_FLOW=
XRAY_VLESS_HOST=
XRAY_VLESS_PORT=
XRAY_VLESS_REMARK=
XRAY_WEBHOOK_PORT=
XRAY_WEBHOOK_TOKEN=  # [SECRET]
XRAY_WEBHOOK_URL=

# --- GitHub / app releases ---
GITHUB_RELEASE_TOKEN=  # [SECRET]

# --- Other / tunables ---
ACTIVE_BYTES_THRESHOLD=
BROADCASTS_ENABLED=
CDN_INBOUND_TAG=
DISABLE_HMR=
LISTEN_HOST=
LISTEN_PORT=
LOG_FILE=
LOG_LEVEL=
NEXT_PUBLIC_STAT_EDITOR_PASSWORD=  # [SECRET]
OPENROUTER_API_KEY=  # [SECRET]
PROTO_ROOT=
TRAFFIC_TIMEOUT=

# ===========================================================
# Remnawave VPN panel (Phase B integration)
# ===========================================================
REMNAWAVE_API_URL=https://panel.hundlervpn.xyz
REMNAWAVE_API_TOKEN=        # [SECRET] panel API token (role: API)
REMNAWAVE_SQUAD_UUID=53e15c43-69aa-4a7b-8737-79042363c463   # Default-Squad (VLESS-Reality)
REMNAWAVE_SUB_DOMAIN=https://sub.hundlervpn.xyz   # public subscription host
