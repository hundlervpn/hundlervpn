[Unit]
Description=HundlerVPN Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/hundlervpn/bot
# Все секреты/конфиг берутся из env-файла, который НЕ коммитится в git.
# Создай /root/hundlervpn/bot/.env из .env.example и впиши реальные значения.
EnvironmentFile=-/root/hundlervpn/bot/.env
ExecStart=/root/hundlervpn/bot/venv/bin/python /root/hundlervpn/bot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target