<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Базовые сетевые права -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Foreground-service для VPNService. Без foreground service
         Android 8+ убьёт сервис через ~5 секунд после ухода в фон. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- На Android 14+ нужно объявлять конкретный type для FGS.
         systemExempted — единственный legal type для VPN на FGS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Notification на Android 13+ — runtime permission. Без неё
         foreground notification не покажется и сервис будет убит. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Просыпаться после reboot если пользователь включил
         "автоматически восстанавливать VPN" (фича на потом). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Sticky сервис должен пережить doze; отключаем battery
         optimization запросом из приложения, не permission'ом. -->

    <!-- Запрос разрешения на установку из неизвестных источников
         НЕ нужен — мы не self-update. Обновления через Play / RuStore. -->

    <!-- QUERY_ALL_PACKAGES — нужно для экрана "Исключения VPN" (per-app
         exclusion), где юзер видит и галочками выбирает приложения,
         обходящие туннель. Без него на Android 11+ getInstalledApplications
         возвращает только packages из <queries> ниже, а нам нужен весь
         список (Сбер, Госуслуги, Тинькофф, и т.п.).

         Google Play allowlists this permission for VPN apps with per-app
         routing as a legitimate core function (см. Play Console Data Safety
         declaration: "Per-app VPN routing requires visibility of all
         installed apps so the user can pick which to tunnel"). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <!-- Открываем браузер для оплаты, Telegram-ссылок, и т.п. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Chrome Custom Tabs Service (Android 11+ package visibility).
             БЕЗ этого блока flutter_web_auth_2 / url_launcher на Android 11+
             не могут "найти" Chrome и фоллбэкают на ACTION_VIEW в обычный
             браузер, что ломает OAuth-callback через deep link. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Telegram (deep link auth, поддержка) -->
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <!-- Chrome — основной провайдер Custom Tabs. -->
        <package android:name="com.android.chrome" />
        <!-- Нужно Flutter engine для PROCESS_TEXT (стандарт Flutter) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:label="Hundler VPN"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="false"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Обычный launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ВНИМАНИЕ: intent-filter для `hundler://` НАМЕРЕННО НЕ ОБЪЯВЛЕН
                 здесь. Все deep links формата `hundler://auth/*` ловит
                 CallbackActivity ниже, которая является внутренней
                 активностью пакета `flutter_web_auth_2` и нужна для того
                 чтобы пакет получил OAuth callback и пробросил его в Dart.

                 Если объявить второй intent-filter здесь, Android при
                 редиректе с Google показывает диалог «Открыть с помощью:
                 MainActivity / CallbackActivity», а если пользователь
                 (или система автоматически) выбрал MainActivity — пакет
                 теряет callback и логин зависает. -->
        </activity>

        <!-- Главный сервис VPN-туннеля. -->
        <service
            android:name=".vpn.HundlerVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- OAuth-callback activity для flutter_web_auth_2.
             Перехватывает `hundler://...` после Google OAuth flow в
             Custom Tab. БЕЗ этого пакет не получит redirect и логин
             зависнет навсегда. См. README пакета.

             ВАЖНО: data filter использует ТОЛЬКО scheme="hundler", без
             host. Так рекомендует README flutter_web_auth_2 и так
             надёжнее: если backend случайно изменит host (например на
             `hundler://callback` вместо `hundler://auth/callback`),
             intent всё равно сматчится. callbackUrlScheme="hundler" в
             Dart-коде получит любой `hundler://*` URL и сам отвалидирует
             path. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hundler" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
