<?xml version="1.0" encoding="utf-8"?>
<!-- Hundler VPN launch background. Чёрный фон (#020202) +
     центрированная иконка тигра. Совпадает с фоном Flutter UI,
     поэтому при появлении первого кадра не будет «прыжка». -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/hundler_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
